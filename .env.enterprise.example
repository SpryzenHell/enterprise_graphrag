GRAGRAPH_ENV=development
GRAGRAPH_JWT_SECRET=replace-with-a-long-random-secret
GRAGRAPH_JWT_ISSUER=http://127.0.0.1:8000
GRAGRAPH_JWT_AUDIENCE=enterprise-graphrag-api
GRAGRAPH_JWT_MODE=shared_secret
GRAGRAPH_JWT_ALGORITHM=HS256
GRAGRAPH_JWT_JWKS_URL=

GRAGRAPH_FAISS_DIR=./enterprise_data/faiss
GRAGRAPH_CORPUS=./enterprise_data/corpus.jsonl

NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Set VLLM_BASE_URL and VLLM_MODEL together. Required when GRAGRAPH_ENV=production.
# Point VLLM_BASE_URL at an OpenAI-compatible vLLM service; example model: Qwen/Qwen2.5-0.5B-Instruct.
VLLM_BASE_URL=
VLLM_API_KEY=dev-token
VLLM_MODEL=
VLLM_MAX_CONTEXT_CHARS=32000
VLLM_MAX_DOCUMENT_CHARS=6000

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=dev-token
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=384

MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp/
MCP_ISSUER_URL=http://127.0.0.1:8000
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

SECURITY_PPL_THRESHOLD=80
SECURITY_PPL_MIN_CLASSIFIER_SCORE=0.10
SECURITY_MARKER_THRESHOLD=2
# Optional Apache-2.0 semantic injection detector. Leave blank to disable.
# Install with: pip install -e ".[security]"
SECURITY_CLASSIFIER_MODEL=
SECURITY_CLASSIFIER_THRESHOLD=0.5
SECURITY_CLASSIFIER_MAX_LENGTH=8192
SECURITY_CLASSIFIER_WINDOW_OVERLAP=512
# auto selects cuda:1 when available (keeping vLLM on cuda:0), else cuda:0 or CPU.
SECURITY_CLASSIFIER_DEVICE=auto
RRF_K=60
VECTOR_WEIGHT=0.55
GRAPH_WEIGHT=0.45
TOP_K=8
ALLOWED_ORIGINS=http://localhost:8000
