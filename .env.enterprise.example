GRAGRAPH_JWT_SECRET=replace-with-a-long-random-secret
GRAGRAPH_JWT_ISSUER=enterprise-graphrag
GRAGRAPH_JWT_AUDIENCE=enterprise-graphrag-api

GRAGRAPH_FAISS_DIR=./enterprise_data/faiss

# Leave blank for the deterministic in-memory graph used by CI.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Leave blank to use the deterministic extractive answerer.
VLLM_BASE_URL=
VLLM_API_KEY=dev-token
VLLM_MODEL=

# Leave blank to use the deterministic hash embedder.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=dev-token
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=384

SECURITY_PPL_THRESHOLD=80
SECURITY_MARKER_THRESHOLD=2
RRF_K=60
VECTOR_WEIGHT=0.55
GRAPH_WEIGHT=0.45
TOP_K=8
ALLOWED_ORIGINS=http://localhost:8000
