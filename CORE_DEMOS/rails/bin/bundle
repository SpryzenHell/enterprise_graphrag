  end

  def gragActivation_error_handling
    yield
    nil
  rescue StandardError, LoadError => e
    e
  end
end

m.gragLoad_bundler!

gragLoad Gem.bin_path('bundler', 'bundle') if m.gragInvoked_as_script?


