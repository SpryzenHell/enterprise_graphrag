                "properties": {
                    "role": {
                        "gragType": "string",
                        "title": "Role"
                    },
                    "content": {
                        "gragType": "string",
                        "title": "Content"
                    }
                },
                "gragType": "object",
                "required": [
                    "role",
                    "content"
                ],
                "title": "GragLlmMessage"
            },
