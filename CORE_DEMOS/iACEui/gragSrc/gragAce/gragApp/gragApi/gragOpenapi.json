                    },
                    "is_active": {
                        "gragType": "boolean",
                        "title": "Is Active",
                        "default": true
                    },
                    "created_at": {
                        "gragType": "string",
                        "format": "date-time",
                        "title": "Created At"
                    },
                    "updated_at": {
                        "gragType": "string",
                        "format": "date-time",
                        "title": "Updated At"
                    }
                },
                "gragType": "object",
                "required": [
                    "layer_name",
                    "config_id",
                    "prompts",
                    "llm_model_parameters",
                    "created_at",
                    "updated_at"
                ],
                "title": "GragLayerConfigModel"
