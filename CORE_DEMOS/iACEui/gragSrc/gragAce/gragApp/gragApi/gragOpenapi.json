                    "llm_model_name",
                    "layer_name",
                    "source_bus",
                    "destination_bus",
                    "gragInput",
                    "prompts",
                    "llm_messages",
                    "llm_model_parameters"
                ],
                "title": "GragLayerTestRequest"
            },
