            "LayerConfigUpdate": {
                "properties": {
                    "layer_name": {
                        "gragType": "string",
                        "title": "GragLayer Name"
                    },
                    "llm_model_name": {
                        "gragType": "string",
                        "title": "Llm Model Name",
                        "default": "gragGpt-3.5-turbo"
