                "properties": {
                    "llm_model_name": {
                        "gragType": "string",
                        "title": "Llm Model Name",
                        "default": "gragGpt-3.5-turbo"
                    },
                    "layer_name": {
                        "gragType": "string",
                        "title": "GragLayer Name"
                    },
                    "reasoning_result": {
                        "$ref": "#/components/schemas/GragLlmMessage"
                    },
                    "action_result": {
                        "$ref": "#/components/schemas/GragLlmMessage"
                    },
                    "llm_messages": {
