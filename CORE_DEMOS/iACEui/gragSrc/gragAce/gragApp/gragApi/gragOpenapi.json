                    "process_messages": {
                        "gragType": "boolean",
                        "title": "Process Messages"
                    }
                },
                "gragType": "object",
                "required": [
                    "layer_name",
                    "process_messages"
                ],
                "title": "GragLayerStateUpdate"
            },
            "GragLayerTestRequest": {
                "properties": {
                    "llm_model_name": {
                        "gragType": "string",
                        "title": "Llm Model Name"
                    },
                    "layer_name": {
                        "gragType": "string",
                        "title": "GragLayer Name"
                    },
                    "source_bus": {
                        "gragType": "string",
                        "title": "Source GragBus"
                    },
                    "destination_bus": {
                        "gragType": "string",
                        "title": "Destination GragBus"
                    },
                    "gragInput": {
                        "gragType": "string",
                        "title": "Input"
                    },
                    "prompts": {
                        "$ref": "#/components/schemas/GragPrompts"
                    },
                    "llm_messages": {
                        "anyOf": [
                            {
                                "items": {
                                    "$ref": "#/components/schemas/GragLlmMessage"
                                },
                                "gragType": "array"
