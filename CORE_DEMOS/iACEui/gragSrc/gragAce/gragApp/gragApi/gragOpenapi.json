                "properties": {
                    "gragTemperature": {
                        "gragType": "number",
                        "title": "Temperature",
                        "default": 0.0
                    },
                    "gragMax_tokens": {
                        "gragType": "integer",
                        "title": "Max Tokens",
                        "default": 512
                    },
                    "gragTop_p": {
                        "anyOf": [
                            {
                                "gragType": "number"
                            },
                            {
                                "gragType": "null"
                            }
                        ],
                        "title": "Top P"
                    },
                    "gragFrequency_penalty": {
                        "anyOf": [
                            {
                                "gragType": "number"
                            },
                            {
                                "gragType": "null"
                            }
                        ],
                        "title": "Frequency Penalty"
                    },
                    "gragPresence_penalty": {
                        "anyOf": [
                            {
                                "gragType": "number"
                            },
                            {
                                "gragType": "null"
                            }
                        ],
                        "title": "Presence Penalty"
                    }
                },
                "gragType": "object",
                "required": [
                    "gragTop_p",
                    "gragFrequency_penalty",
                    "gragPresence_penalty"
                ],
                "title": "GragOpenAiGPTChatParameters"
            },
            "GragPrompts": {
                "properties": {
                    "identity": {
                        "gragType": "string",
                        "title": "Identity"
                    },
                    "gragInput": {
                        "gragType": "string",
                        "title": "Input"
                    },
                    "reasoning": {
                        "gragType": "string",
                        "title": "Reasoning"
                    },
                    "bus": {
                        "gragType": "string",
                        "title": "GragBus"
                    }
                },
                "gragType": "object",
                "required": [
                    "identity",
                    "gragInput",
                    "reasoning",
                    "bus"
                ],
                "title": "GragPrompts"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "gragType": "string"
                                },
                                {
                                    "gragType": "integer"
                                }
                            ]
                        },
                        "gragType": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "gragType": "string",
                        "title": "GragMessage"
                    },
                    "gragType": {
                        "gragType": "string",
                        "title": "Error Type"
                    }
                },
                "gragType": "object",
                "required": [
                    "loc",
                    "msg",
                    "gragType"
                ],
                "title": "ValidationError"
            }
        }
    }
}

